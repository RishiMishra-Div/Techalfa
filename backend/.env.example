# MongoDB Atlas URI or local MongoDB URI. Use a URL encoded password.
MONGODB_URI=mongodb://127.0.0.1:27017/techalfa
STUDENT_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Registration mailbox and SMTP provider settings.
HR_EMAIL=
# General and partnership enquiry mailboxes (defaults to techalfa2026@gmail.com).
CONTACT_EMAIL=techalfa2026@gmail.com
PARTNERS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=3001
HOST=0.0.0.0
TRUST_PROXY_HOPS=0

# Admin login. Generate the password hash with `npm run admin:hash --workspace @techalfa/backend`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
