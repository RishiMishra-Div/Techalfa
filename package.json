{
  "name": "techalfa-community-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @techalfa/frontend",
    "dev:backend": "npm run dev --workspace @techalfa/backend",
    "build": "npm run build --workspace @techalfa/frontend",
    "lint": "npm run lint --workspace @techalfa/frontend && npm run lint --workspace @techalfa/backend",
    "start": "npm run start --workspace @techalfa/backend"
  }
}
